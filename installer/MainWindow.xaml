<Window x:Class="EyeBreakSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eye Break Setup" Width="620" Height="430"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="#E8E6F0">
    <Window.Resources>
        <LinearGradientBrush x:Key="Gold" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F6D27A" Offset="0"/>
            <GradientStop Color="#D99A3A" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#1A1206"/>
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#E8E6F0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#F0EEF8"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="CaretBrush" Value="#F6D27A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8D5E4"/>
            <Setter Property="Margin" Value="0,9,0,0"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#22FFFFFF"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Gold}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderBrush="#40E8B04A" BorderThickness="1" MouseLeftButtonDown="Drag">
        <Border.Background>
            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="1.1">
                <GradientStop Color="#2B1752" Offset="0"/>
                <GradientStop Color="#0C0B1E" Offset="0.6"/>
                <GradientStop Color="#05050C" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>

        <Grid Margin="34,22,34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource Ghost}" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-18,0" Click="CloseBtn_Click"/>
            <Button x:Name="MusicBtn" Content="♪" ToolTip="Music on/off" Style="{StaticResource Ghost}" Background="Transparent"
                    Foreground="#F6D27A" FontSize="15" Padding="12,4"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,24,0" Click="MusicBtn_Click"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Image Source="/eye.ico" Width="54" Height="54"/>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="EYE BREAK" FontSize="30" FontWeight="Light" Foreground="{StaticResource Gold}"/>
                    <TextBlock Text="Rest your eyes with a journey past a black hole" Foreground="#9C98B4" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="SetupPanel" Grid.Row="1" Margin="0,30,0,0">
                <TextBlock Text="Install to" Foreground="#9C98B4" FontSize="12" Margin="0,0,0,6"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="Browse_Click"/>
                    <TextBox x:Name="PathBox"/>
                </DockPanel>
                <CheckBox x:Name="DesktopBox" Content="Add a desktop shortcut" IsChecked="True" Margin="0,18,0,0"/>
                <CheckBox x:Name="StartupBox" Content="Start Eye Break with Windows" IsChecked="True"/>
                <CheckBox x:Name="LaunchBox" Content="Open Eye Break when setup finishes" IsChecked="True"/>
            </StackPanel>

            <StackPanel x:Name="ProgressPanel" Grid.Row="1" Margin="0,46,0,0" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" Text="Installing…" FontSize="18" FontWeight="Light"/>
                <ProgressBar x:Name="Bar" Height="6" Margin="0,14,0,0" Maximum="100"/>
                <TextBlock x:Name="FileText" Foreground="#7E7A96" FontSize="11.5" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
            </StackPanel>

            <DockPanel Grid.Row="2">
                <Button x:Name="InstallBtn" DockPanel.Dock="Right" Content="INSTALL" Click="InstallBtn_Click"/>
                <TextBlock x:Name="FooterText" VerticalAlignment="Center" Foreground="#6E6A86" FontSize="11.5"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
